<Window
    x:Class="YoutubeDownloader.XC.Views.Dialogs.AuthWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:auth="clr-namespace:YoutubeDownloader.XC.Auth"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Title="{Binding LocalizationManager.AuthenticationTitle}"
    Width="980"
    Height="720"
    MinWidth="720"
    MinHeight="520"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen"
    x:DataType="auth:AuthSetupViewModel"
    Icon="/favicon.ico">
    <DockPanel Background="{DynamicResource AppPageBrush}">
        <Border
            Height="40"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppChromeEdgeBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Panel>
                        <materialIcons:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource AppAccentBrush}"
                            IsVisible="{Binding !IsAuthenticated}"
                            Kind="AccountKey" />
                        <materialIcons:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="#66BB6A"
                            IsVisible="{Binding IsAuthenticated}"
                            Kind="AccountCheck" />
                    </Panel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppChromeForegroundBrush}"
                        Text="{Binding LocalizationManager.AuthenticationTitle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="46"
                    Height="40"
                    Classes="caption close"
                    Click="CloseButton_OnClick"
                    Theme="{DynamicResource MaterialFlatButton}"
                    WindowDecorationProperties.ElementRole="CloseButton">
                    <materialIcons:MaterialIcon Width="16" Height="16" Kind="WindowClose" />
                </Button>
            </Grid>
        </Border>
        <auth:AuthSetupView />
    </DockPanel>
</Window>
