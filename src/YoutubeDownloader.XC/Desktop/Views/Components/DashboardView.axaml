<UserControl
    x:Class="YoutubeDownloader.XC.Views.Components.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:components="clr-namespace:YoutubeDownloader.XC.ViewModels.Components"
    xmlns:converters="clr-namespace:YoutubeDownloader.XC.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:materialStyles="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    x:Name="UserControl"
    x:DataType="components:DashboardViewModel"
    Loaded="UserControl_OnLoaded">
    <DockPanel>
        <!--  Header  -->
        <StackPanel
            Background="{DynamicResource AppChromeBrush}"
            DockPanel.Dock="Top"
            Orientation="Vertical">
            <Grid Margin="12,8,8,8" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <AutoCompleteBox
                    x:Name="QueryTextBox"
                    Grid.Column="0"
                    MinHeight="32"
                    MaxHeight="36"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FilterMode="ContainsOrdinal"
                    ItemsSource="{Binding QuerySuggestions}"
                    PlaceholderText="{Binding LocalizationManager.QueryPlaceholderText}"
                    Text="{Binding Query}"
                    ToolTip.Tip="{Binding LocalizationManager.QueryTooltip}" />
                <Button
                    x:Name="ProcessQueryButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="1"
                    VerticalAlignment="Center"
                    Classes="icon"
                    Command="{Binding ProcessQueryCommand}"
                    IsDefault="True"
                    ToolTip.Tip="{Binding LocalizationManager.ProcessQueryTooltip}">
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="ArrowRight" />
                </Button>

                <!--  Paste  -->
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Classes="primary"
                    Command="{Binding PasteCommand}"
                    ToolTip.Tip="{Binding LocalizationManager.PasteTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="ContentPaste" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LocalizationManager.PasteButton}" />
                    </StackPanel>
                </Button>

                <!--  Auth button  -->
                <Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="1"
                    VerticalAlignment="Center"
                    Command="{Binding ShowAuthSetupCommand}"
                    Foreground="{DynamicResource MaterialDarkForegroundBrush}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.AuthTooltip}">
                    <materialIcons:MaterialIcon
                        Width="16"
                        Height="16"
                        Kind="AccountKey" />
                </Button>

                <!--  Settings button  -->
                <Button
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Padding="1"
                    VerticalAlignment="Center"
                    Command="{Binding ShowSettingsCommand}"
                    Foreground="{DynamicResource MaterialDarkForegroundBrush}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.SettingsTooltip}">
                    <materialIcons:MaterialIcon
                        Width="16"
                        Height="16"
                        Kind="Settings" />
                </Button>
            </Grid>

            <!--  Defaults  -->
            <Grid Margin="12,0,12,8" ColumnDefinitions="Auto,Auto,80,Auto,130,*">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <materialIcons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Kind="VideoOutline" />
                    <ToggleSwitch IsChecked="{Binding IsAudioDefault}" />
                    <materialIcons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Kind="MusicNote" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,6,0"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Text="Format:" />
                <ComboBox
                    Grid.Column="2"
                    Width="80"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding FormatChoices}"
                    SelectedItem="{Binding SelectedFormat}" />

                <TextBlock
                    Grid.Column="3"
                    Margin="12,0,6,0"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsAudioDefault}"
                    Opacity="0.75"
                    Text="Quality:" />
                <ComboBox
                    Grid.Column="4"
                    Width="130"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsAudioDefault}"
                    ItemsSource="{Binding DefaultBitrateChoices}"
                    SelectedItem="{Binding SelectedDefaultBitrate}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Classes.unsupported="{Binding !IsNative}"
                                    VerticalAlignment="Center"
                                    Text="{Binding Label}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.unsupported">
                                            <Setter Property="Foreground" Value="#C47B00" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <materialIcons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !IsNative}"
                                    Kind="InformationOutline"
                                    ToolTip.Tip="{Binding #UserControl.DataContext.LocalizationManager.UnsupportedBitrateTooltip}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button
                    Grid.Column="5"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    Padding="10,4"
                    Classes="primary"
                    Command="{Binding DownloadAllCommand}"
                    Content="{Binding LocalizationManager.DownloadAllButton}" />
                <Button
                    Grid.Column="5"
                    Margin="0,0,120,0"
                    HorizontalAlignment="Right"
                    Padding="1"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.SettingsTooltip}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Command="{Binding PasteCommand}" Header="{Binding LocalizationManager.PasteButton}" InputGesture="Ctrl+V" />
                            <MenuItem Command="{Binding DownloadAllCommand}" Header="{Binding LocalizationManager.DownloadAllButton}" />
                            <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                            <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="Stop waiting" />
                            <MenuItem Command="{Binding OpenFolderCommand}" Header="{Binding LocalizationManager.OpenFolderLabel}" />
                            <MenuItem Command="{Binding ShowHistoryCommand}" Header="{Binding LocalizationManager.HistoryTitle}" />
                            <MenuItem Command="{Binding ShowSettingsCommand}" Header="{Binding LocalizationManager.SettingsTitle}" />
                            <MenuItem Command="{Binding ToggleFilterVisibleCommand}" Header="Show / hide filter" />
                            <MenuItem Command="{Binding ToggleTopmostCommand}" Header="Stay on top" />
                            <MenuItem Command="{Binding OpenErrorLogCommand}" Header="Error log" />
                            <MenuItem Command="{Binding UndoRemoveCommand}" Header="Undo remove" IsEnabled="{Binding CanUndoRemove}" />
                            <MenuItem Header="Sort">
                                <MenuItem Command="{Binding SortByTitleCommand}" Header="Title" />
                                <MenuItem Command="{Binding SortByDurationCommand}" Header="Duration" />
                                <MenuItem Command="{Binding SortByStatusCommand}" Header="Status" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding ShowHelpCommand}" Header="{Binding LocalizationManager.HelpTitle}" />
                            <MenuItem Command="{Binding QuitAppCommand}" Header="Quit" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="Cog" />
                </Button>
            </Grid>

            <!--  Progress  -->
            <ProgressBar
                Height="2"
                Background="Transparent"
                IsIndeterminate="{Binding IsProgressIndeterminate}"
                Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />
        </StackPanel>

        <!--  Bottom bar  -->
        <Border
            Padding="8,6"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppChromeEdgeBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <Button
                    Grid.Column="0"
                    Padding="1"
                    Command="{Binding ClearCompletedCommand}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.ContextMenuRemoveSuccessful}">
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="PlaylistRemove" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    Text="{Binding LocalizationManager.SpeedLimitLabel}" />
                <ComboBox
                    Grid.Column="2"
                    MinWidth="140"
                    ItemsSource="{Binding SpeedLimits}"
                    SelectedItem="{Binding SelectedSpeedLimit}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel
                    Grid.Column="3"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock Text="{Binding SpeedText}" />
                    <TextBlock Opacity="0.8" Text="{Binding UsageText}" />
                </StackPanel>
                <Button
                    Grid.Column="4"
                    Padding="1"
                    Command="{Binding OpenFolderCommand}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="FolderOpen" />
                </Button>
                <Button
                    Grid.Column="5"
                    Padding="1"
                    Command="{Binding ShowHistoryCommand}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.HistoryTooltip}">
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="History" />
                </Button>
                <Button
                    Grid.Column="6"
                    Padding="1"
                    Command="{Binding ShowHelpCommand}"
                    Classes="icon"
                    ToolTip.Tip="{Binding LocalizationManager.HelpTooltip}">
                    <materialIcons:MaterialIcon Width="15" Height="15" Kind="HelpCircleOutline" />
                </Button>
            </Grid>
        </Border>

        <!--  Body  -->
        <Panel Background="{DynamicResource AppPageBrush}" DockPanel.Dock="Bottom">
            <!--  Placeholder  -->
            <StackPanel
                Margin="8,32,8,8"
                HorizontalAlignment="Center"
                IsVisible="{Binding !Downloads.Count}"
                Orientation="Vertical">
                <materialIcons:MaterialIcon
                    Width="256"
                    Height="256"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource MaterialDividerBrush}"
                    Kind="Youtube" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Light"
                    Inlines="{Binding LocalizationManager.DashboardPlaceholder, Converter={x:Static converters:MarkdownToInlinesConverter.Instance}}"
                    LineSpacing="8"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Downloads -->
            <DockPanel IsVisible="{Binding !!Downloads.Count}">
                <Grid
                    Margin="8,4"
                    ColumnDefinitions="*,Auto,Auto,Auto"
                    DockPanel.Dock="Top"
                    IsVisible="{Binding IsFilterVisible}">
                    <TextBox
                        Grid.Column="0"
                        Classes="line"
                        PlaceholderText="Filter by title"
                        Text="{Binding QueueSearch}" />
                    <ComboBox
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinWidth="120"
                        ItemsSource="{Binding QueueFilters}"
                        SelectedItem="{Binding QueueFilter}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="Compact cards" />
                    <ToggleSwitch
                        Grid.Column="3"
                        Margin="0,0,0,0"
                        IsChecked="{Binding IsCompact}"
                        ToolTip.Tip="Show or hide the extra fields on each card" />
                </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleDownloads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding RemoveSuccessfulDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveSuccessful}" />
                            <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveInactive}" />
                            <Separator />
                            <MenuItem Command="{Binding RestartFailedDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRestartFailed}" />
                            <Separator />
                            <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Classes="queueCard"
                                Classes.selected="{Binding IsSelected}"
                                Margin="8,4"
                                ClipToBounds="True"
                                Opacity="0"
                                PointerPressed="Card_OnPointerPressed"
                                DoubleTapped="Card_OnDoubleTapped">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                    </Transitions>
                                </Border.Transitions>
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Style.Animations>
                                            <Animation Duration="0:0:0.28" FillMode="Forward">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="0" />
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="1" />
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Border.Styles>
                                <Grid ColumnDefinitions="4,*">
                                    <Border
                                        Grid.Column="0"
                                        Background="{Binding StatusAccentBrushKey, Converter={x:Static converters:StatusAccentBrushConverter.Instance}}"
                                        CornerRadius="12,0,0,12" />
                                    <Grid Grid.Column="1">
                                    <Border IsHitTestVisible="False" CornerRadius="0,12,12,0" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Offset="0" Color="#66F9A825" />
                                                <GradientStop Offset="{Binding FillFraction}" Color="#66F9A825" />
                                                <GradientStop Offset="{Binding FillFraction}" Color="Transparent" />
                                                <GradientStop Offset="1" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid RowDefinitions="Auto,*">
                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <materialIcons:MaterialIcon
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                Kind="VideoOutline" />
                                            <ToggleSwitch
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsAudioMode}"
                                                IsEnabled="{Binding CanEdit}" />
                                            <materialIcons:MaterialIcon
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                Kind="MusicNote" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="8,0,8,6" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto">
                                        <Border
                                            Grid.Column="0"
                                            Width="104"
                                            Height="68"
                                            CornerRadius="10"
                                            ClipToBounds="True"
                                            BoxShadow="0 2 8 0 #33000000">
                                            <Panel>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" Stretch="UniformToFill" />
                                            <Border
                                                Padding="4,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="4"
                                                Background="#CC000000"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="White"
                                                    Text="{Binding DurationText}" />
                                            </Border>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,6,0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                IsVisible="{Binding PlaylistTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Opacity="0.75"
                                                Text="{Binding PlaylistTitle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                IsVisible="{Binding !ShowAudioDetails}"
                                                Text="{Binding EditedTitle}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding EditedTitle}" />
                                            <Grid Margin="0,2,0,2" ColumnDefinitions="Auto,72,12,Auto,*">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Format:" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Width="72"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanEdit}"
                                                    ItemsSource="{Binding FormatChoices}"
                                                    SelectedItem="{Binding SelectedContainer}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Quality:" />
                                                <Panel Grid.Column="4" VerticalAlignment="Center">
                                                    <ComboBox
                                                        MinWidth="120"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanEdit}"
                                                        IsVisible="{Binding IsAudioMode}"
                                                        ItemsSource="{Binding BitrateChoices}"
                                                        SelectedItem="{Binding SelectedBitrateChoice}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock
                                                                        Classes.unsupported="{Binding !IsNative}"
                                                                        VerticalAlignment="Center"
                                                                        Text="{Binding Label}">
                                                                        <TextBlock.Styles>
                                                                            <Style Selector="TextBlock.unsupported">
                                                                                <Setter Property="Foreground" Value="#C47B00" />
                                                                            </Style>
                                                                        </TextBlock.Styles>
                                                                    </TextBlock>
                                                                    <materialIcons:MaterialIcon
                                                                        Width="16"
                                                                        Height="16"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding !IsNative}"
                                                                        Kind="InformationOutline"
                                                                        ToolTip.Tip="{Binding #UserControl.DataContext.LocalizationManager.UnsupportedBitrateTooltip}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <ItemsControl IsVisible="{Binding ShowQualityChips}" ItemsSource="{Binding QualityChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button
                                                                    Margin="0,0,4,2"
                                                                    Padding="6,1"
                                                                    Classes="chip"
                                                                    Classes.selected="{Binding IsSelected}"
                                                                    Command="{Binding $parent[ItemsControl].((components:DownloadViewModel)DataContext).SelectQualityCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{Binding Label}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Panel>
                                            </Grid>
                                            <Grid
                                                Margin="0,2,0,0"
                                                ColumnDefinitions="Auto,*,12,Auto,*"
                                                IsVisible="{Binding ShowAudioDetails}">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Title:" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanEdit}"
                                                    Text="{Binding EditedTitle}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Artist:" />
                                                <TextBox
                                                    Grid.Column="4"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanEdit}"
                                                    Text="{Binding EditedArtist}" />
                                            </Grid>
                                            <Grid
                                                Margin="0,2,0,0"
                                                ColumnDefinitions="Auto,*,12,Auto,*"
                                                IsVisible="{Binding ShowAudioDetails}">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Year:" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanEdit}"
                                                    Text="{Binding EditedYear}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.75"
                                                    Text="Album:" />
                                                <TextBox
                                                    Grid.Column="4"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanEdit}"
                                                    Text="{Binding EditedAlbum}" />
                                            </Grid>
                                            <WrapPanel IsVisible="{Binding CanEdit}" Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowSubtitleChoice}"
                                                    Opacity="0.75"
                                                    Text="Subtitles:" />
                                                <ComboBox
                                                    Width="88"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowSubtitleChoice}"
                                                    ItemsSource="{Binding SubtitleChoices}"
                                                    SelectedItem="{Binding SubtitleChoice}" />
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Opacity="0.75"
                                                    Text="Start:" />
                                                <TextBox
                                                    Width="64"
                                                    Margin="0,0,10,0"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Text="{Binding ClipStartText}" />
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Opacity="0.75"
                                                    Text="End:" />
                                                <TextBox
                                                    Width="64"
                                                    Margin="0,0,10,0"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Text="{Binding ClipEndText}" />
                                                <TextBlock
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Opacity="0.75"
                                                    Text="Cover:" />
                                                <TextBox
                                                    Width="64"
                                                    Margin="0,0,10,0"
                                                    Classes="line"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !IsAudioMode}"
                                                    Text="{Binding CoverTimeText}" />
                                                <CheckBox
                                                    Margin="0,0,8,0"
                                                    Content="Video only"
                                                    IsChecked="{Binding VideoOnly}"
                                                    IsVisible="{Binding !IsAudioMode}" />
                                                <CheckBox
                                                    Content="SRT"
                                                    IsChecked="{Binding SaveSrt}"
                                                    IsVisible="{Binding !IsAudioMode}" />
                                            </WrapPanel>
                                            <TextBlock
                                                Opacity="0.8"
                                                PointerReleased="StatusTextBlock_OnPointerReleased"
                                                Text="{Binding ProgressLabel}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding ErrorMessage}" />
                                            <TextBlock
                                                Opacity="0.7"
                                                IsVisible="{Binding TimeRemainingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding TimeRemainingText}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal"
                                            Spacing="16">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.75"
                                                IsVisible="{Binding FileNamePreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding FileNamePreview}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.75"
                                                IsVisible="{Binding EstimatedSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding EstimatedSizeText}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <ProgressBar
                                                Width="22"
                                                Height="22"
                                                IsIndeterminate="True"
                                                IsVisible="{Binding IsLoading}"
                                                Theme="{DynamicResource MaterialCircularProgressBar}" />
                                            <Button
                                                Padding="1"
                                                Classes="icon"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).ImportPlaylistCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanImportPlaylist}"
                                                IsVisible="{Binding PlaylistId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                ToolTip.Tip="{Binding LocalizationManager.ImportPlaylistTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="PlaylistPlay" />
                                            </Button>
                                            <Button
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="1"
                                                Classes="primary icon"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).StartDownloadCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanStart}"
                                                ToolTip.Tip="{Binding LocalizationManager.DownloadButton}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Download" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding PauseDownloadCommand}"
                                                IsVisible="{Binding CanPause}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.PauseLabel}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Pause" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding ResumeDownloadCommand}"
                                                IsVisible="{Binding CanResume}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.ResumeLabel}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Play" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).CopyLinkCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanCopyLink}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.CopyLinkLabel}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="ContentCopy" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).SaveAudioFromFileCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanSaveAudio}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.SaveAudioLabel}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="MusicNote" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding ShowFileCommand}"
                                                IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="FileFindOutline" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding OpenFileCommand}"
                                                IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.PlayTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="PlayCircleOutline" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding CancelCommand}"
                                                IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="StopCircleOutline" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).ReloadCardCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanReload}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Reload" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).DownloadAgainCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanDownloadAgain}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Download" />
                                            </Button>
                                            <Button
                                                Padding="1"
                                                Command="{Binding #UserControl.((components:DashboardViewModel)DataContext).CloseCardCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                <materialIcons:MaterialIcon Width="15" Height="15" Kind="Close" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
        </Panel>
    </DockPanel>
</UserControl>
