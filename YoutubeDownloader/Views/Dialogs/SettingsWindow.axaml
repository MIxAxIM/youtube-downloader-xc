<Window
    x:Class="YoutubeDownloader.Views.Dialogs.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:views="clr-namespace:YoutubeDownloader.Views.Dialogs"
    Title="{Binding LocalizationManager.SettingsTitle}"
    Width="780"
    Height="560"
    MinWidth="640"
    MinHeight="420"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner"
    x:DataType="dialogs:SettingsViewModel"
    Icon="/favicon.ico">
    <DockPanel Background="{DynamicResource AppPageBrush}">
        <Border
            Height="40"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppChromeEdgeBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <materialIcons:MaterialIcon
                        Width="18"
                        Height="18"
                        Foreground="{DynamicResource AppAccentBrush}"
                        Kind="CogOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppChromeForegroundBrush}"
                        Text="{Binding LocalizationManager.SettingsTitle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="46"
                    Height="40"
                    Classes="caption close"
                    Click="CloseButton_OnClick"
                    Theme="{DynamicResource MaterialFlatButton}"
                    WindowDecorationProperties.ElementRole="CloseButton">
                    <materialIcons:MaterialIcon Width="16" Height="16" Kind="WindowClose" />
                </Button>
            </Grid>
        </Border>
        <Border
            Margin="12"
            Padding="4"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource AppCardShadow}"
            CornerRadius="14">
            <views:SettingsView />
        </Border>
    </DockPanel>
</Window>
