<UserControl
    x:Class="YoutubeDownloader.Views.Dialogs.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:YoutubeDownloader.ViewModels.Dialogs"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Width="640"
    Height="480"
    x:DataType="dialogs:HistoryViewModel">
    <Border
        Background="{DynamicResource AppCardBrush}"
        BorderBrush="{DynamicResource AppCardBorderBrush}"
        BorderThickness="1"
        BoxShadow="{DynamicResource AppCardShadow}"
        CornerRadius="14"
        Margin="4">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            Grid.Row="0"
            Margin="16"
            FontSize="19"
            FontWeight="SemiBold"
            Text="{Binding LocalizationManager.HistoryTitle}" />

        <ComboBox
            Grid.Row="1"
            Margin="16,0,16,8"
            Width="160"
            HorizontalAlignment="Left"
            ItemsSource="{Binding TimeFilters}"
            SelectedItem="{Binding TimeFilter}" />

        <Border
            Grid.Row="2"
            Margin="8,0"
            Background="{DynamicResource AppPageBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding VisibleEntries}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                            <materialIcons:MaterialIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Kind="FileVideoOutline" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding Duration}" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Padding="4"
                                Command="{Binding $parent[ListBox].((dialogs:HistoryViewModel)DataContext).OpenCommand}"
                                CommandParameter="{Binding}"
                                Theme="{DynamicResource MaterialFlatButton}">
                                <materialIcons:MaterialIcon Kind="Play" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Padding="4"
                                Command="{Binding $parent[ListBox].((dialogs:HistoryViewModel)DataContext).CopyLinkCommand}"
                                CommandParameter="{Binding}"
                                Theme="{DynamicResource MaterialFlatButton}">
                                <materialIcons:MaterialIcon Kind="ContentCopy" />
                            </Button>
                            <Button
                                Grid.Column="4"
                                Padding="4"
                                Command="{Binding $parent[ListBox].((dialogs:HistoryViewModel)DataContext).RedownloadCommand}"
                                CommandParameter="{Binding}"
                                Theme="{DynamicResource MaterialFlatButton}">
                                <materialIcons:MaterialIcon Kind="Download" />
                            </Button>
                            <Button
                                Grid.Column="5"
                                Padding="4"
                                Command="{Binding $parent[ListBox].((dialogs:HistoryViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}"
                                Theme="{DynamicResource MaterialFlatButton}">
                                <materialIcons:MaterialIcon Kind="DeleteOutline" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <UniformGrid Grid.Row="3" Margin="8" Columns="3">
            <Button
                Margin="8"
                Command="{Binding ExportCommand}"
                Content="Export"
                Theme="{DynamicResource MaterialOutlineButton}" />
            <Button
                Margin="8"
                Command="{Binding ClearCommand}"
                Content="{Binding LocalizationManager.ClearHistoryButton}"
                Theme="{DynamicResource MaterialOutlineButton}" />
            <Button
                Margin="8"
                Command="{Binding CloseCommand}"
                Content="{Binding LocalizationManager.CloseButton}"
                IsCancel="True"
                IsDefault="True"
                Theme="{DynamicResource MaterialOutlineButton}" />
        </UniformGrid>
    </Grid>
    </Border>
</UserControl>
