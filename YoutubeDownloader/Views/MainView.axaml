<Window
    x:Class="YoutubeDownloader.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:materialStyles="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:viewModels="clr-namespace:YoutubeDownloader.ViewModels"
    Title="{Binding Title}"
    Width="760"
    Height="660"
    MinWidth="640"
    MinHeight="440"
    x:DataType="viewModels:MainViewModel"
    ExtendClientAreaToDecorationsHint="True"
    Icon="/favicon.ico"
    RenderOptions.BitmapInterpolationMode="HighQuality"
    CanResize="True"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!--  Custom title bar  -->
        <Border
            x:Name="TitleBar"
            Height="40"
            Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppChromeEdgeBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource AppAccentBrush}"
                        CornerRadius="6">
                        <materialIcons:MaterialIcon
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#1A1A1A"
                            Kind="Youtube" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppChromeForegroundBrush}"
                        Text="YoutubeDownloader" />
                    <Border
                        Padding="8,2"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        CornerRadius="999">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppAccentBrush}"
                            Text="{Binding VersionLabel}" />
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Button
                        Width="46"
                        Height="40"
                        Padding="0"
                        Classes="caption"
                        Click="MinimizeButton_OnClick"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="Minimize"
                        WindowDecorationProperties.ElementRole="MinimizeButton">
                        <materialIcons:MaterialIcon Width="16" Height="16" Kind="WindowMinimize" />
                    </Button>
                    <Button
                        x:Name="MaximizeButton"
                        Width="46"
                        Height="40"
                        Padding="0"
                        Classes="caption"
                        Click="MaximizeButton_OnClick"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="Maximize"
                        WindowDecorationProperties.ElementRole="MaximizeButton">
                        <materialIcons:MaterialIcon
                            x:Name="MaximizeIcon"
                            Width="16"
                            Height="16"
                            Kind="WindowMaximize" />
                    </Button>
                    <Button
                        Width="46"
                        Height="40"
                        Padding="0"
                        Classes="caption close"
                        Click="CloseButton_OnClick"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="Close"
                        WindowDecorationProperties.ElementRole="CloseButton">
                        <materialIcons:MaterialIcon Width="16" Height="16" Kind="WindowClose" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <dialogHostAvalonia:DialogHost
            x:Name="DialogHost"
            CloseOnClickAway="False"
            DisableOpeningAnimation="True">
            <materialStyles:SnackbarHost HostName="Root" SnackbarMaxCounts="3">
                <ContentControl Content="{Binding Dashboard}" />
            </materialStyles:SnackbarHost>
        </dialogHostAvalonia:DialogHost>
    </DockPanel>
</Window>
